# ============================================
# Python 多功能智能助手 环境变量模板
# 复制为 .env 后填入真实值；.env 不要提交到 git
# ============================================

# ---- Flask 环境 ----
FLASK_ENV=development            # development / production / testing
SECRET_KEY=your-secret-key-here  # 生产环境用 openssl rand -hex 32 生成
HOST=0.0.0.0                     # 开发服务监听地址（run.py）
PORT=5000                        # 开发服务端口（Gunicorn 环境默认 8000）

# ---- 大模型 ----
DEFAULT_MODEL=deepseek           # 默认模型：deepseek / qwen
TEMPERATURE=0.7
MAX_TOKENS=2048

# DeepSeek（对话主模型）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# 通义千问（可选备用模型；同时用于知识库向量化 text-embedding-v3）
# 若该 Key 欠费/不可用，知识库会自动降级为关键词检索
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_MODEL=qwen-plus

# ---- 数据库（MySQL）----
# 格式：mysql+pymysql://用户名:密码@地址:3306/库名
# 本机开发默认 localhost；Docker Compose 部署时把地址改成 mysql（服务名）
DATABASE_URL=mysql+pymysql://assistant:YourStrongPassword!@localhost:3306/smart_assistant

# ---- Redis（可选，限流用）----
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT=60                    # 每 IP 每分钟最多请求次数

# ---- Milvus 向量库（知识库语义检索用）----
# 目前地址写在 app/services/kb_vector_service.py 的 MILVUS_URI，默认 localhost:19530
# 未连接时知识库自动降级为 BM25 关键词检索，功能不受影响

# ---- 语音合成 TTS（可选）----
# 火山引擎（console.volcengine.com 开通语音合成）
VOLCANO_TTS_APP_ID=
VOLCANO_TTS_TOKEN=

# 腾讯云（console.cloud.tencent.com 开通语音合成）
TENCENT_TTS_SECRET_ID=
TENCENT_TTS_SECRET_KEY=

# ---- 阿里云短信（可选，注册/登录验证码）----
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
